# Entornos virtuales
venv/
env/
.env

# Caché de Python y compilados
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Datos (No subir datasets al repositorio)
data/raw/*
data/processed/*
downloaded_files/*
reports/*

# Excepciones: Mantener la estructura de carpetas en GitHub
!data/raw/.gitkeep
!data/processed/.gitkeep
!downloaded_files/.gitkeep
!reports/.gitkeep

# Logs
*.log

# Streamlit config y cache si procede
.streamlit/credentials.toml
